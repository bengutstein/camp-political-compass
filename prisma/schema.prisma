generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizSubmission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  xScore      Float
  yScore      Float
  answersJson String
  optionalName String?
}
